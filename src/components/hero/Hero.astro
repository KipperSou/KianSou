---
import { withBase } from '@/utils/base'
import { SocialList } from './SocialList'
import Highlight from '@/components/Highlight.astro'
import Config from '@/astro-obsidian.config'

const { hero, author } = Config

const identityTags = ['Builder', 'Blogger', 'Long-term Thinker']
const focusTags = ['项目复盘', '技术实践', '产品思考']
---

<div class="lg:-mt-16 lg:h-dvh lg:min-h-[720px]">
  <div
    class="relative max-w-[1300px] mx-auto h-full px-4 grid lg:grid-cols-[minmax(0,590px)_minmax(320px,420px)] items-center justify-between gap-10"
  >
    <div class="mt-[120px] lg:mt-0 max-w-[590px]">
      <h1 class="text-3xl text-center lg:text-left text-balance">
        Hi there, I'm
        <Highlight class="font-bold">{hero.name}</Highlight>
        <br />{hero.bio}
      </h1>
      <div class="text-sm text-secondary mt-3 text-center lg:text-left">{hero.description}</div>
      <SocialList className="mt-[60px]" client:load />
    </div>

    <div class="mt-14 lg:mt-0 flex justify-center lg:justify-end">
      <div class="relative w-[300px] lg:w-[388px]">
        <div class="absolute -inset-4 -z-1 rounded-[2.6rem] bg-accent/10 blur-3xl"></div>
        <div
          class="rounded-[2rem] border border-white/10 bg-gradient-to-br from-black/95 to-neutral-950/90 shadow-2xl shadow-black/30 backdrop-blur-sm overflow-hidden"
        >
          <div class="relative px-6 pt-6 pb-5 border-b border-white/10">
            <div class="absolute top-5 right-5 flex gap-1.5">
              <span class="size-2.5 rounded-full bg-white/20"></span>
              <span class="size-2.5 rounded-full bg-accent/60"></span>
              <span class="size-2.5 rounded-full bg-white/20"></span>
            </div>
            <div
              class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-[11px] uppercase tracking-[0.22em] text-slate-300"
            >
              <span class="size-2 rounded-full bg-accent"></span>
              Personal Card
            </div>
            <div class="mt-4">
              <div class="text-2xl font-bold text-white">{hero.name}</div>
              <div class="mt-1 text-sm text-slate-300">独立表达者 / 构建者 / 长期主义者</div>
            </div>
            <div class="mt-4 flex flex-wrap gap-2">
              {
                identityTags.map((tag) => (
                  <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-slate-200">
                    {tag}
                  </span>
                ))
              }
            </div>
          </div>

          <div class="px-5 pt-5">
            <div class="rounded-[1.5rem] bg-black overflow-hidden">
              <img
                class="w-full h-[300px] lg:h-[340px] object-cover object-top scale-[1.24] translate-y-[-20px]"
                src={withBase(author.avatar)}
                alt="Site owner avatar"
                loading="lazy"
              />
            </div>
          </div>

          <div class="px-6 py-5">
            <div class="text-xs uppercase tracking-[0.2em] text-slate-400">Current Focus</div>
            <div class="mt-3 flex flex-wrap gap-2">
              {
                focusTags.map((tag) => (
                  <span class="rounded-full bg-accent/15 px-3 py-1 text-xs text-slate-100 ring-1 ring-accent/20">
                    {tag}
                  </span>
                ))
              }
            </div>
            <p class="mt-4 text-sm leading-7 text-slate-300">
              用稳定输出替代短期喧哗，把博客作为作品、方法和长期积累的公开界面。
            </p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 lg:mt-0 lg:absolute inset-x-0 bottom-0 flex flex-col items-center">
      <p class="text-xs text-center text-balance text-secondary">
        {hero.yiyan}
      </p>
      <div class="mt-7 text-xl animate-bounce">
        <i class="iconfont icon-down"></i>
      </div>
    </div>
  </div>
</div>
